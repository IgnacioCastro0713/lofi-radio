@page "/"
@rendermode InteractiveServer
@using Radio.Application.Services
@using Radio.Application.DTOs
@using Radio.Domain.Models
@inject IRadioStreamService StreamService
@inject IJSRuntime JSRuntime
@inject ILogger<Home> Logger
@implements IDisposable

<PageTitle>Lofi Radio 24/7 - Sincronizado Global</PageTitle>

<div class="lofi-container">
    <!-- Widescreen Cinematic Overlay Filters -->
    <div class="crt-overlay"></div>

    <div class="lofi-dashboard">
        <!-- Widescreen Cinematic Player Card (16:9 Aspect Ratio) -->
        <div class="lofi-card player-card @(CurrentState?.Track?.Mood?.ToLower() ?? "day") @(IsPlaying ? "playing" : "")">

            <!-- Pixel Art Viewport Container (fills the background) -->
            <div class="pixel-art-viewport">
                <div class="live-badge @(IsPlaying ? "playing" : "")">
                    <span class="live-dot"></span>
                    @(IsPlaying ? "LIVE STREAMING" : "STREAM SYNCED")
                </div>
                
                @if (CurrentState?.Track?.Mood?.ToLower() == "evening")
                {
                     <!-- Evening SVG (Sunset Coffee Shop) -->
                     <svg class="pixel-scene" viewBox="0 0 400 240">
                         <!-- Sky Gradient -->
                         <defs>
                             <linearGradient id="eveningSky" x1="0" y1="0" x2="0" y2="1">
                                 <stop offset="0%" stop-color="#4c1c5c" />
                                 <stop offset="40%" stop-color="#bf3b56" />
                                 <stop offset="75%" stop-color="#e97640" />
                                 <stop offset="100%" stop-color="#f2b340" />
                             </linearGradient>
                         </defs>
                         <rect width="400" height="240" fill="url(#eveningSky)" />
                         
                         <!-- Mountain outlines (retro pixel look) -->
                         <polygon points="0,170 80,120 180,170" fill="#301540" opacity="0.8" />
                         <polygon points="120,170 230,100 350,170" fill="#251033" opacity="0.9" />
                         <polygon points="280,170 360,110 400,150" fill="#1c0a26" />
                         
                         <!-- Golden Sun (Setting) -->
                         <circle cx="200" cy="115" r="28" fill="#f7d070" />
                         <rect x="170" y="118" width="60" height="2" fill="#bf3b56" opacity="0.5" />
                         <rect x="180" y="122" width="40" height="2" fill="#bf3b56" opacity="0.5" />
                         
                         <!-- Ground/Horizon base -->
                         <rect x="0" y="165" width="400" height="75" fill="#150a21" />
                         
                         <!-- Cozy Window Frame -->
                         <rect x="20" y="20" width="360" height="190" fill="none" stroke="#2a1b40" stroke-width="8" />
                         <!-- Window Divider Cross -->
                         <rect x="198" y="20" width="4" height="190" fill="#2a1b40" />
                         <rect x="20" y="100" width="360" height="4" fill="#2a1b40" />
                         
                         <!-- Steaming Coffee Cup on Sill -->
                         <rect x="80" y="150" width="24" height="16" fill="#f2b340" rx="2" />
                         <path d="M104,153 c3,0 5,2 5,5 c0,3 -2,5 -5,5" fill="none" stroke="#f2b340" stroke-width="2" />
                         <!-- Animated steam particles -->
                         <g class="steam-group">
                             <path class="steam-line steam1" d="M84,142 Q86,135 84,130" fill="none" stroke="#e97640" stroke-width="1.5" stroke-linecap="round" />
                             <path class="steam-line steam2" d="M92,142 Q90,135 92,130" fill="none" stroke="#e97640" stroke-width="1.5" stroke-linecap="round" />
                             <path class="steam-line steam3" d="M98,144 Q100,137 98,132" fill="none" stroke="#e97640" stroke-width="1.5" stroke-linecap="round" />
                         </g>
                         
                         <!-- Gentle raining pixels -->
                         <g class="rain-group">
                             <line class="rain-drop drop1" x1="120" y1="30" x2="115" y2="45" stroke="#90d3ff" stroke-width="1" opacity="0.6" />
                             <line class="rain-drop drop2" x1="280" y1="50" x2="275" y2="65" stroke="#90d3ff" stroke-width="1" opacity="0.4" />
                             <line class="rain-drop drop3" x1="60" y1="70" x2="55" y2="85" stroke="#90d3ff" stroke-width="1" opacity="0.5" />
                             <line class="rain-drop drop4" x1="330" y1="80" x2="325" y2="95" stroke="#90d3ff" stroke-width="1" opacity="0.6" />
                         </g>
                     </svg>
                }
                else if (CurrentState?.Track?.Mood?.ToLower() == "night")
                {
                     <!-- Night SVG (Midnight Starry Sleep) -->
                     <svg class="pixel-scene" viewBox="0 0 400 240">
                         <!-- Deep Space Sky -->
                         <defs>
                             <linearGradient id="nightSky" x1="0" y1="0" x2="0" y2="1">
                                 <stop offset="0%" stop-color="#080517" />
                                 <stop offset="60%" stop-color="#150f2e" />
                                 <stop offset="100%" stop-color="#2d1c4d" />
                             </linearGradient>
                         </defs>
                         <rect width="400" height="240" fill="url(#nightSky)" />
                         
                         <!-- Glowing Neon Crescent Moon -->
                         <path d="M290,40 A 25,25 0 0,1 290,90 A 20,20 0 0,0 305,45 A 25,25 0 0,1 290,40" fill="#e9d6ff" class="neon-moon" />
                         
                         <!-- Star fields (twinkling) -->
                         <g class="star-group">
                             <rect class="star star1" x="50" y="40" width="3" height="3" fill="#ffffff" />
                             <rect class="star star2" x="120" y="60" width="2" height="2" fill="#e9d6ff" />
                             <rect class="star star3" x="220" y="30" width="3" height="3" fill="#ffffff" />
                             <rect class="star star4" x="80" y="100" width="2" height="2" fill="#ffffff" />
                             <rect class="star star5" x="340" y="70" width="3" height="3" fill="#e9d6ff" />
                             <rect class="star star6" x="180" y="90" width="2" height="2" fill="#ffffff" />
                         </g>

                         <!-- Retro Cyber City Skyline silhouettes -->
                         <rect x="0" y="140" width="50" height="100" fill="#0c0717" />
                         <rect x="30" y="160" width="45" height="80" fill="#080410" />
                         <rect x="110" y="130" width="60" height="110" fill="#0d081a" />
                         <rect x="150" y="150" width="40" height="90" fill="#0c0717" />
                         <rect x="250" y="120" width="50" height="120" fill="#0d081a" />
                         <rect x="330" y="135" width="70" height="115" fill="#0c0717" />
                         
                         <!-- Glowing Windows in Buildings -->
                         <g class="city-lights">
                             <rect x="10" y="150" width="4" height="6" fill="#f7d070" />
                             <rect x="20" y="170" width="4" height="6" fill="#ff4566" opacity="0.8" />
                             <rect x="120" y="140" width="6" height="8" fill="#90d3ff" opacity="0.9" />
                             <rect x="140" y="170" width="6" height="8" fill="#f7d070" />
                             <rect x="270" y="140" width="5" height="10" fill="#e9d6ff" opacity="0.8" />
                             <rect x="360" y="150" width="8" height="6" fill="#f7d070" />
                         </g>
                         
                         <!-- Interior Bedroom Window Frame overlay -->
                         <rect x="15" y="15" width="370" height="210" fill="none" stroke="#120c1f" stroke-width="10" />
                         <rect x="197" y="15" width="6" height="210" fill="#120c1f" />
                         <rect x="15" y="115" width="370" height="6" fill="#120c1f" />
                         
                         <!-- Sleeping cat silhouette on sill -->
                         <path d="M90,115 c0,-4 3,-7 7,-7 c4,0 6,3 6,7 h2 c0,-8 -4,-12 -8,-12 c-4,0 -6,2 -7,4 c-1,-2 -3,-4 -7,-4 c-4,0 -8,4 -8,12 h2" fill="#080410" />
                         <ellipse cx="88" cy="113" rx="8" ry="5" fill="#080410" />
                         <ellipse cx="94" cy="114" rx="5" ry="4" fill="#080410" />
                         <!-- Sleeping tail -->
                         <path d="M101,114 Q106,112 108,118" fill="none" stroke="#080410" stroke-width="2" />
                     </svg>
                }
                else if (CurrentState?.Track?.Mood?.ToLower() == "pixel")
                {
                     <!-- Pixel SVG (Classic Retro Game) -->
                     <svg class="pixel-scene" viewBox="0 0 400 240">
                         <!-- Retro Grid / Scanline Sky -->
                         <defs>
                             <linearGradient id="pixelSky" x1="0" y1="0" x2="0" y2="1">
                                 <stop offset="0%" stop-color="#05170d" />
                                 <stop offset="50%" stop-color="#0c2e17" />
                                 <stop offset="100%" stop-color="#1b4d24" />
                             </linearGradient>
                         </defs>
                         <rect width="400" height="240" fill="url(#pixelSky)" />
                         
                         <!-- Pixel grid lines (Synthwave retro game grid) -->
                         <line x1="200" y1="120" x2="0" y2="240" stroke="#00ff7f" stroke-width="1" opacity="0.3" />
                         <line x1="200" y1="120" x2="100" y2="240" stroke="#00ff7f" stroke-width="1" opacity="0.3" />
                         <line x1="200" y1="120" x2="200" y2="240" stroke="#00ff7f" stroke-width="1" opacity="0.3" />
                         <line x1="200" y1="120" x2="300" y2="240" stroke="#00ff7f" stroke-width="1" opacity="0.3" />
                         <line x1="200" y1="120" x2="400" y2="240" stroke="#00ff7f" stroke-width="1" opacity="0.3" />
                         
                         <!-- Horizontal perspective grid lines -->
                         <line x1="0" y1="140" x2="400" y2="140" stroke="#00ff7f" stroke-width="1" opacity="0.1" />
                         <line x1="0" y1="165" x2="400" y2="165" stroke="#00ff7f" stroke-width="1" opacity="0.2" />
                         <line x1="0" y1="195" x2="400" y2="195" stroke="#00ff7f" stroke-width="1" opacity="0.3" />
                         
                         <!-- Retro Big Sun on Horizon -->
                         <ellipse cx="200" cy="120" rx="35" ry="35" fill="#00ff7f" opacity="0.8" />
                         <!-- Sun bars -->
                         <rect x="160" y="110" width="80" height="3" fill="#05170d" />
                         <rect x="160" y="120" width="80" height="4" fill="#05170d" />
                         <rect x="160" y="132" width="80" height="6" fill="#05170d" />
                         
                         <!-- Vintage Console / Handheld Frame Overlay (Skeuomorphic Retro handheld Screen) -->
                         <rect x="40" y="15" width="320" height="210" fill="none" stroke="#252c28" stroke-width="12" rx="10" />
                         <rect x="42" y="17" width="316" height="206" fill="none" stroke="#151b18" stroke-width="2" rx="8" />
                         
                         <!-- Small pixelated sprites / floating details -->
                         <g class="retro-sprite">
                             <!-- Space Invader Crab shape -->
                             <path d="M55,35 h4 v2 h-4 v-2 M51,37 h12 v2 h-12 v-2 M49,39 h16 v2 h-16 v-2 M49,41 h3 v2 h4 v-2 h2 v2 h4 v-2 h3 v2 M53,43 h10 v2 h-10 v-2 M51,45 h2 v2 h8 v-2 h2 v2" fill="#00ff7f" opacity="0.7" class="invader-float" />
                         </g>
                         
                         <!-- Retro 8-bit text label on console -->
                         <text x="50" y="215" font-family="'Courier New', monospace" font-size="8" fill="#151b18" font-weight="bold">8-BIT SYSTEM</text>
                     </svg>
                }
                else if (CurrentState?.Track?.Mood?.ToLower() == "synthwave")
                {
                     <!-- Synthwave SVG (1980s Infinite Outrun Laser Grid) -->
                     <svg class="pixel-scene" viewBox="0 0 400 240">
                         <!-- Cyber Twilight Sunset Sky -->
                         <defs>
                             <linearGradient id="synthwaveSky" x1="0" y1="0" x2="0" y2="1">
                                 <stop offset="0%" stop-color="#120525" />
                                 <stop offset="40%" stop-color="#3c0a52" />
                                 <stop offset="75%" stop-color="#8c117b" />
                                 <stop offset="100%" stop-color="#f02473" />
                             </linearGradient>
                         </defs>
                         <rect width="400" height="240" fill="url(#synthwaveSky)" />
                         
                         <!-- Glowing Vector Grid Sun setting -->
                         <circle cx="200" cy="110" r="32" fill="#ff7f00" class="neon-sun" />
                         <rect x="160" y="92" width="80" height="3" fill="#3c0a52" />
                         <rect x="160" y="100" width="80" height="4" fill="#3c0a52" />
                         <rect x="160" y="112" width="80" height="5" fill="#3c0a52" />
                         <rect x="160" y="126" width="80" height="7" fill="#3c0a52" />
                         
                         <!-- Perspective neon lines moving dynamically! -->
                         <g stroke="#00f0ff" stroke-width="1.5" opacity="0.6">
                             <line x1="200" y1="130" x2="-50" y2="240" />
                             <line x1="200" y1="130" x2="50" y2="240" />
                             <line x1="200" y1="130" x2="150" y2="240" />
                             <line x1="200" y1="130" x2="250" y2="240" />
                             <line x1="200" y1="130" x2="350" y2="240" />
                             <line x1="200" y1="130" x2="450" y2="240" />
                         </g>
                         
                         <!-- Horizontal moving perspective lines (with an animation) -->
                         <g class="grid-horizontal-lines" stroke="#ff007f" stroke-width="1.5" opacity="0.5">
                             <line x1="0" y1="140" x2="400" y2="140" class="grid-line line1" />
                             <line x1="0" y1="155" x2="400" y2="155" class="grid-line line2" />
                             <line x1="0" y1="175" x2="400" y2="175" class="grid-line line3" />
                             <line x1="0" y1="200" x2="400" y2="200" class="grid-line line4" />
                             <line x1="0" y1="230" x2="400" y2="230" class="grid-line line5" />
                         </g>

                         <!-- Horizon bar -->
                         <rect x="0" y="129" width="400" height="3" fill="#00f0ff" opacity="0.8" />
                         
                         <!-- Cyber city outline silhouettes on the sides of the horizon -->
                         <polygon points="0,130 15,100 25,105 35,90 50,110 65,115 80,130" fill="#120525" />
                         <polygon points="320,130 340,115 355,95 370,110 385,100 400,130" fill="#120525" />
                         
                         <!-- Outrun Sports Car Silhouette cruising in the center of the grid -->
                         <g class="outrun-car">
                             <!-- Spoiler and body back -->
                             <rect x="180" y="194" width="40" height="6" fill="#05020a" />
                             <polygon points="176,194 180,194 180,200 176,198" fill="#05020a" />
                             <polygon points="224,194 220,194 220,200 224,198" fill="#05020a" />
                             
                             <!-- Wheels with cyan underglow -->
                             <circle cx="184" cy="208" r="5" fill="#020104" />
                             <circle cx="216" cy="208" r="5" fill="#020104" />
                             <ellipse cx="184" cy="211" rx="8" ry="2" fill="#00f0ff" opacity="0.6" class="neon-underglow" />
                             <ellipse cx="216" cy="211" rx="8" ry="2" fill="#00f0ff" opacity="0.6" class="neon-underglow" />
                             
                             <!-- Car cabin and spoiler lights (magenta) -->
                             <rect x="188" y="196" width="24" height="8" fill="#0b0314" />
                             <rect x="182" y="195" width="4" height="2" fill="#ff007f" class="car-light" />
                             <rect x="214" y="195" width="4" height="2" fill="#ff007f" class="car-light" />
                         </g>
                     </svg>
                }
                else
                {
                     <!-- Day SVG (Focus Cozy Desk - Default) -->
                     <svg class="pixel-scene" viewBox="0 0 400 240">
                         <!-- Soft Morning Sky -->
                         <defs>
                             <linearGradient id="daySky" x1="0" y1="0" x2="0" y2="1">
                                 <stop offset="0%" stop-color="#b8e2f2" />
                                 <stop offset="60%" stop-color="#daeff5" />
                                 <stop offset="100%" stop-color="#ffebd4" />
                             </linearGradient>
                         </defs>
                         <rect width="400" height="240" fill="url(#daySky)" />
                         
                         <!-- Soft Retro Sun peaking -->
                         <circle cx="120" cy="80" r="22" fill="#ffcd60" />
                         <rect x="0" y="150" width="400" height="90" fill="#ece1d5" />
                         
                         <!-- Hills outlines -->
                         <path d="M-20,160 Q100,100 240,160 T420,160 L420,240 L-20,240 Z" fill="#b0cc99" opacity="0.75" />
                         <path d="M150,165 Q250,120 380,165 L380,240 L150,240 Z" fill="#99bc80" />
                         
                         <!-- Cozy Desk with computer monitor -->
                         <rect x="40" y="20" width="320" height="190" fill="none" stroke="#684f3a" stroke-width="8" />
                         <rect x="198" y="20" width="4" height="190" fill="#684f3a" />
                         
                         <!-- Plant on windowsill -->
                         <rect x="290" y="130" width="16" height="20" fill="#ac8052" />
                         <path d="M290,130 C280,120 285,105 295,115 C305,105 310,120 300,130" fill="#99bc80" />
                         
                         <!-- Steam coffee mug -->
                         <rect x="70" y="138" width="18" height="12" fill="#ff9cfc" rx="1" />
                         <!-- Anim steam -->
                         <g class="steam-group">
                             <path class="steam-line steam1" d="M74,132 Q76,127 74,124" fill="none" stroke="#daeff5" stroke-width="1.2" />
                             <path class="steam-line steam2" d="M80,132 Q78,127 80,124" fill="none" stroke="#daeff5" stroke-width="1.2" />
                         </g>
                     </svg>
                }

                <!-- Overlapping AI-Generated GCS Image (on top of SVG fallback, with smooth load & error hide) -->
                @if (CurrentState != null)
                {
                    <img class="ai-generated-scene" src="@GetMoodImageUrl(CurrentState.Track)" alt="AI Pixel Art" style="opacity: 0; transition: opacity 0.5s;" onload="this.style.opacity=1;" onerror="this.style.display='none';" />
                }

                <!-- Top Right Ambient Mood Tagline -->
                <div class="hero-tagline">
                    <span class="tagline-icon">
                        @if (CurrentState?.Track?.Mood?.ToLower() == "day") { <text>🌅</text> }
                        else if (CurrentState?.Track?.Mood?.ToLower() == "evening") { <text>🌇</text> }
                        else if (CurrentState?.Track?.Mood?.ToLower() == "night") { <text>🌌</text> }
                        else if (CurrentState?.Track?.Mood?.ToLower() == "synthwave") { <text>🏎️</text> }
                        else { <text>👾</text> }
                    </span>
                    <span class="tagline-text @(CurrentState?.Track?.Mood?.ToLower())">
                        @GetMoodLabel(CurrentState?.Track?.Mood)
                    </span>
                </div>

            </div>

            <!-- Sleek Translucent Integrated Bottom Player Bar -->
            @if (CurrentState != null)
            {
                <div class="integrated-player-bar">
                    <div class="bar-content">
                        <!-- Left Section: Track Title and listeners status -->
                        <div class="bar-left">
                            <div class="bar-song-title-wrapper">
                                <div class="bar-song-title" @onclick="HandleTitleClick" style="cursor: pointer; user-select: none;">
                                    <span>@CurrentState!.Track!.Title</span>
                                </div>
                                @if (CurrentState.Track.CreatedAt.UtcDateTime.Date == DateTime.UtcNow.Date)
                                {
                                    <span class="new-badge">NEW</span>
                                }
                                <div class="sound-wave @(IsPlaying ? "playing" : "")" title="@(IsPlaying ? "Playing" : "Paused")">
                                    <span></span>
                                    <span></span>
                                    <span></span>
                                    <span></span>
                                </div>
                            </div>
                            <div class="bar-song-sub">
                                @if (_showSecretInfo)
                                {
                                    <span style="color: #ff007f; font-weight: bold; font-family: monospace; font-size: 11px;">
                                        Seq: @CurrentState.Track.SequenceIndex | Start: @(CurrentState.Track.PlayStartTime != null ? CurrentState.Track.PlayStartTime.Value.ToOffset(TimeSpan.FromMinutes(-_clientTimezoneOffsetMinutes)).ToString("HH:mm:ss") : "N/A") | Created: @CurrentState.Track.CreatedAt.ToOffset(TimeSpan.FromMinutes(-_clientTimezoneOffsetMinutes)).ToString("yyyy-MM-dd HH:mm:ss")
                                    </span>
                                }
                                else
                                {
                                    <span class="stream-status-indicator @(IsPlaying ? "active" : "")"></span>
                                    <text>128 kbps • @GetMoodGenreLabel(CurrentState.Track.Mood)</text>
                                }
                            </div>
                        </div>

                        <!-- Center Section: Playback Toggle and Widescreen Progress Slider -->
                        <div class="bar-center">
                            <button class="bar-play-btn" @onclick="TogglePlayback" title="@(IsPlaying ? "Pause Stream" : "Listen Live")">
                                @if (IsPlaying)
                                {
                                    <svg class="pause-svg" viewBox="0 0 24 24">
                                        <path fill="#ffffff" d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                                    </svg>
                                }
                                else
                                {
                                    <svg class="play-svg" viewBox="0 0 24 24">
                                        <path fill="#ffffff" d="M8 5v14l11-7z"/>
                                    </svg>
                                }
                            </button>

                            <div class="bar-timeline-container">
                                <span class="bar-time" id="lofiCurrentTime">00:00</span>
                                <div class="bar-slider-wrapper" style="pointer-events: none;">
                                    <input type="range" id="lofiTimelineSlider" class="bar-timeline-slider" min="0" max="100" step="0.1" 
                                           value="0" readonly />
                                </div>
                                <span class="bar-time" id="lofiTotalTime">00:00</span>
                            </div>
                        </div>

                        <!-- Right Section: Volume Slider & Fullscreen -->
                        <div class="bar-right">
                            <span class="bar-volume-icon" title="@(Volume < 0.01 ? "Unmute" : "Mute")" @onclick="ToggleMute" style="cursor: pointer;">
                                <svg class="speaker-svg" viewBox="0 0 24 24">
                                    @if (Volume < 0.01)
                                    {
                                         <!-- Mute Speaker Body with an elegant neon pink/red 'X' cross -->
                                         <path fill="#ff4566" d="M3 9v6h4l5 5V4L7 9H3zm16 3l-3-3m0 6l3-3"/>
                                    }
                                    else
                                    {
                                         <!-- Full volume speaker with waves -->
                                         <path fill="#ffffff" d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                                    }
                                </svg>
                            </span>
                            <div class="bar-volume-container">
                                <span class="volume-badge">@(Math.Round(Volume * 100))%</span>
                                <input type="range" class="bar-volume-slider" min="0" max="1" step="0.01" 
                                       value="@Volume" @oninput="OnVolumeChange" />
                            </div>
                            <button class="fullscreen-btn" @onclick="ToggleFullscreen" title="Toggle Fullscreen" type="button">
                                <svg viewBox="0 0 24 24">
                                    <path fill="currentColor" d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- Toast HUD Notification -->
            <div id="lofiHudToast" class="hud-toast"></div>

            <!-- Hidden Native HTML5 Audio Player -->
            <audio id="nativeLofiAudio" crossorigin="anonymous" style="display: none;"></audio>

            <!-- Render loading state or server-side connection errors -->
            @if (CurrentState == null)
            {
                <div class="empty-state">
                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <span class="text-danger">@ErrorMessage</span>
                    }
                    else
                    {
                        <span>Loading station...</span>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private DotNetObjectReference<Home>? _selfRef;

    private int _clickCount = 0;
    private bool _showSecretInfo = false;
    private DateTime _lastClickTime = DateTime.MinValue;
    private int _clientTimezoneOffsetMinutes = 0;

    private void HandleTitleClick()
    {
        var now = DateTime.UtcNow;
        if ((now - _lastClickTime).TotalMilliseconds > 1500)
        {
            _clickCount = 0;
        }

        _clickCount++;
        _lastClickTime = now;

        if (_clickCount >= 3)
        {
            _showSecretInfo = !_showSecretInfo;
            _clickCount = 0;
        }
    }

    public StreamStateDto? CurrentState { get; set; }
    public bool IsPlaying { get; set; }
    public double Volume { get; set; } = 0.5;
    public double CurrentTime { get; set; }
    public double Duration { get; set; }
    public string? ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Load initial stream state and history on the server side first (prerender safe!)
        await SyncStreamStateAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Initialize the player
                _selfRef = DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync("lofiPlayer.init", _selfRef);

                // Get client browser timezone offset in minutes
                _clientTimezoneOffsetMinutes = await JSRuntime.InvokeAsync<int>("eval", "new Date().getTimezoneOffset()");
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to initialize audio player.");
                ErrorMessage = "Could not initialize audio system.";
                StateHasChanged();
            }
        }
    }

    private async Task SyncStreamStateAsync()
    {
        try
        {
            CurrentState = await StreamService.GetCurrentStreamStateAsync();
            
            if (CurrentState == null)
            {
                ErrorMessage = "The radio queue is currently empty. Run the generator worker.";
            }
            else
            {
                ErrorMessage = null;
                CurrentTime = CurrentState.OffsetSeconds;
                Duration = CurrentState.Track.DurationSeconds;
                
                // If the stream is currently active and client is playing, we align the player offset (JS-safe check)
                if (IsPlaying && _selfRef != null)
                {
                    await JSRuntime.InvokeVoidAsync("lofiPlayer.syncAndPlay", GetPlayableAudioUrl(CurrentState.Track), CurrentState.OffsetSeconds, CurrentState.Track.Title, CurrentState.Track.Mood, GetMoodImageUrl(CurrentState.Track));
                }

                // Pre-load the NEXT track metadata into the JS player to support locked screen seamless playback
                if (CurrentState.NextTrack != null && _selfRef != null)
                {
                    await JSRuntime.InvokeVoidAsync("lofiPlayer.setNextTrack", GetPlayableAudioUrl(CurrentState.NextTrack), CurrentState.NextTrack.Title, CurrentState.NextTrack.Mood, GetMoodImageUrl(CurrentState.NextTrack));
                }
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error syncing stream state.");
            ErrorMessage = "Connection error with radio server.";
            StateHasChanged();
        }
    }

    private async Task TogglePlayback()
    {
        if (IsPlaying)
        {
            await JSRuntime.InvokeVoidAsync("lofiPlayer.pause");
        }
        else
        {
            // Re-sync stream state on play action to start exactly at the current global timestamp
            await SyncStreamStateAsync();
            if (CurrentState != null)
            {
                await JSRuntime.InvokeVoidAsync("lofiPlayer.syncAndPlay", GetPlayableAudioUrl(CurrentState.Track), CurrentState.OffsetSeconds, CurrentState.Track.Title, CurrentState.Track.Mood, GetMoodImageUrl(CurrentState.Track));
            }
        }
    }

    private async Task OnVolumeChange(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var vol))
        {
            Volume = vol;
            await JSRuntime.InvokeVoidAsync("lofiPlayer.setVolume", Volume);
        }
    }

    private double _previousVolume = 0.5;

    private async Task ToggleMute()
    {
        if (Volume > 0)
        {
            _previousVolume = Volume;
            Volume = 0;
        }
        else
        {
            Volume = _previousVolume > 0 ? _previousVolume : 0.5;
        }

        await JSRuntime.InvokeVoidAsync("lofiPlayer.setVolume", Volume);
        StateHasChanged();
    }

    private async Task ToggleFullscreen()
    {
        await JSRuntime.InvokeVoidAsync("lofiPlayer.toggleFullscreen");
    }

    [JSInvokable]
    public virtual void OnPlaybackStatusChanged(bool playing)
    {
        IsPlaying = playing;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnTimeUpdate(double currentTime, double duration)
    {
        CurrentTime = currentTime;
        Duration = duration;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnTrackEnded()
    {
        Logger.LogInformation("Track ended. Transitioning UI and fetching next track.");

        // Optimistic UI Pre-transition: Reset timeline and advance metadata immediately 
        // to keep the visual state in perfect sync with the instant JavaScript audio transition
        if (CurrentState?.NextTrack != null)
        {
            var nextTrack = CurrentState.NextTrack;
            CurrentState = new StreamStateDto
            {
                Track = nextTrack,
                OffsetSeconds = 0,
                NextTrack = null // We will load the next-next track from Firestore in a moment
            };
            CurrentTime = 0;
            Duration = nextTrack.DurationSeconds;
            StateHasChanged(); // Force immediate render before Firestore await
        }
        else
        {
            CurrentTime = 0;
            Duration = 0;
            StateHasChanged();
        }

        // 1. Fetch next track state safely (avoiding async event timing conflicts)
        CurrentState = await StreamService.GetCurrentStreamStateAsync();
        
        if (CurrentState == null)
        {
            ErrorMessage = "The radio queue is currently empty. Run the generator worker.";
        }
        else
        {
            ErrorMessage = null;
            IsPlaying = true;
            CurrentTime = CurrentState.OffsetSeconds;
            Duration = CurrentState.Track.DurationSeconds;
            
            // Trigger JS play deterministically in a single call to start playback of the new track
            await JSRuntime.InvokeVoidAsync("lofiPlayer.syncAndPlay", GetPlayableAudioUrl(CurrentState.Track), CurrentState.OffsetSeconds, CurrentState.Track.Title, CurrentState.Track.Mood, GetMoodImageUrl(CurrentState.Track));

            // Pre-load the NEXT track metadata into the JS player to support locked screen seamless playback
            if (CurrentState.NextTrack != null)
            {
                await JSRuntime.InvokeVoidAsync("lofiPlayer.setNextTrack", GetPlayableAudioUrl(CurrentState.NextTrack), CurrentState.NextTrack.Title, CurrentState.NextTrack.Mood, GetMoodImageUrl(CurrentState.NextTrack));
            }
        }
        
        StateHasChanged();
    }

    [JSInvokable]
    public void OnPlaybackError(string message)
    {
        ErrorMessage = message;
        IsPlaying = false;
        StateHasChanged();
    }

    private static string GetPlayableAudioUrl(RadioTrack? track)
    {
        if (track == null) return string.Empty;
        
        // If it is a relative path (local fallback /media/...), play it directly
        if (!track.AudioUrl.StartsWith("http"))
        {
            return track.AudioUrl;
        }
        
        // Secure proxy streaming - routes the private GCS request securely through our authorized Web container!
        return $"/api/stream/audio/{track.FileName}";
    }

    private static string GetMoodGenreLabel(string? mood)
    {
        if (string.IsNullOrEmpty(mood)) return "Lo-Fi Beats";
        return mood.ToLower() switch
        {
            "day" => "Day Focus Lo-Fi",
            "evening" => "Evening Jazzhop",
            "night" => "Sleep Ambient",
            "pixel" => "8/16-Bit Chiptune",
            "synthwave" => "Outrun Retrowave",
            _ => "Lo-Fi Beats"
        };
    }

    private static string GetMoodLabel(string? mood)
    {
        if (string.IsNullOrEmpty(mood)) return "LOFI VIBES";
        return mood.ToLower() switch
        {
            "day" => "DAY FOCUS",
            "evening" => "CHILL COFFEE",
            "night" => "NIGHT GLOW",
            "pixel" => "RETRO PIXEL",
            "synthwave" => "OUTRUN VIBES",
            _ => "LOFI VIBES"
        };
    }

     private static string GetMoodImageUrl(RadioTrack? track)
    {
        if (track == null || string.IsNullOrEmpty(track.ImagePath)) return "/images/day_fallback.webp";
        
        // Securely route the image path from metadata directly through our proxy!
        return $"/api/stream/audio/{track.ImagePath}";
    }



    public void Dispose()
    {
        _selfRef?.Dispose();
    }
}
