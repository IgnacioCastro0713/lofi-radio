# Google Cloud Project Configuration Template for PROD
# Replace with your actual Google Cloud Project ID (e.g., "my-lofi-radio-project-prod")
project_id  = "your-gcp-project-id-prod"

# The Google Cloud region where all serverless resources will be deployed (e.g., "us-central1")
region      = "us-central1"

# The Docker image tag to deploy (e.g., "v0.4.24" or "latest")
image_tag   = "v0.4.24"

# The number of daily looping tracks to generate dynamically
# This controls the size of the infinite circular queue and adapts C# dynamically!
track_count = 25

# AI models for music and image generator
music_model = "lyria-3-pro-preview"
image_model = "gemini-3.1-flash-image"

# IAM members granted access via IAP (roles/iap.httpsResourceAccessor)
iap_authorized_domains = ["domain:<domain.com>"]
